# Copie este arquivo para .env e preencha com seus valores.
# O .env contem credenciais de projeto e NUNCA deve ser commitado.

# --- Google Cloud ---
# Projeto que sera cobrado pelas queries no BigQuery
GCP_PROJECT_ID=seu-project-id

# Bucket do Cloud Storage que hospeda a camada Bronze
GCS_BUCKET=seu-bucket-datalake

# Datasets do BigQuery - camadas Silver e Gold
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold

# Regiao dos recursos (padrao: Sao Paulo)
GCP_REGION=southamerica-east1

# --- Pub/Sub (ingestao streaming) ---
PUBSUB_TOPIC=indicador-updates
PUBSUB_SUBSCRIPTION=indicador-updates-sub
